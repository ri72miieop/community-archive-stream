{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "companion/*.test.ts",
    "scripts/preview-companion.ts",
    "output"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "postcss.config.js"
  ],
  "compilerOptions": {
    "paths": {
      "~*": [
        "./*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "baseUrl": "."
  }
}
